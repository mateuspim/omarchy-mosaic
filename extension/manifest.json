{
  "manifest_version": 3,
  "name": "Omarchy Mosaic",
  "version": "0.3.0",
  "description": "Connects Omarchy Mosaic tiles to the Mosaic shell plugin. Installed by the pym.mosaic plugin.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging", "tabs", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background-3.js" }
}
